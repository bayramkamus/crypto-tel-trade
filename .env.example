# Telegram API bilgileri
# 1. https://my.telegram.org adresine girin.
# 2. API development tools bolumunden api_id ve api_hash alin.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=pump_research

# Optional: comma-separated channels can be used instead of configs/channels.yml.
# TELEGRAM_CHANNELS=binancekillers,BitcoinBullets
CHANNELS_CONFIG=configs/channels.yml

# SQLite paths
DB_PATH=pump_research.db
BACKFILL_DAYS=30
BACKFILL_BATCH_SIZE=100

# SMTP mail ayarlari
# Gmail kullaniyorsaniz 2FA acip App Password olusturun.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=true
REPORT_EMAIL_TO=

# Opsiyonel haber/AI servisleri
CRYPTOPANIC_TOKEN=
OPENAI_API_KEY=

# Opsiyonel chart pattern modeli
ENABLE_CHART_PATTERN=true
CHART_PATTERN_MODEL_DIR=models/chart_pattern_model_1777159444

